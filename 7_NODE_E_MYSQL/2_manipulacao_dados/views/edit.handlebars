<h1>Editar Livro</h1>
<p>Altere os campos abaixo para atualizar o livro.</p>


<form action="/books/updatebook" method="POST">
    <input type="hidden" name="id" value="{{book.id}}">

    <div class="form-control">
        <label for="title">Título do Livro:</label>
        <input type="text" id="title" name="title" value="{{book.tittle}}" required>
    </div>

    <div class="form-control">
        <label for="pageqty">Quantidade de Páginas:</label>
        <input type="number" id="pageqty" name="pageqty" value="{{book.pageqty}}" required>
    </div>
    <div class="form-control">
        <label for="id">ID do Livro:</label>
        <input type="number" id="id" name="id" value="{{book.id}}" readonly>
    </div>

    <input type="submit" value="Salvar Alterações">
</form>

